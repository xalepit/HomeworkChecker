<Page
  x:Class="HomeworkChecker.UI.Views.Pages.TestDataPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:HomeworkChecker.UI.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="TestDataPage"
  d:DataContext="{d:DesignInstance local:TestDataPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
    <StackPanel>
        <Menu Margin="0,10,0,10">
            <MenuItem Header="导入 txt/dat">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="保存">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            
        </Menu>
        <!--之后需要换成自定义的UserControl，现在的TextBox无法显示滚动条-->
        <TextBox 
            Text="{Binding ViewModel.TestDataText, Mode=TwoWay}"
            AcceptsReturn="True"
            AcceptsTab="True"
            TextWrapping="NoWrap"
            MinHeight="200"
            MaxHeight="600"/>
    </StackPanel>
</Page>
