<Page
  x:Class="HomeworkChecker.UI.Views.Pages.TestDataPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:HomeworkChecker.UI.Views.Pages"
  xmlns:res="clr-namespace:HomeworkChecker.UI.Resources"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  d:DataContext="{d:DesignInstance local:TestDataPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10">
            <ui:Button Command="{Binding ViewModel.ImportCommand}"
                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       Padding="10,6"
                       Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding [TestData_Import], Source={x:Static res:Translations.Current}}" />
                </StackPanel>
            </ui:Button>
            <ui:Button Command="{Binding ViewModel.SaveCommand}"
                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       Padding="10,6"
                       Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Save24" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding [TestData_Save], Source={x:Static res:Translations.Current}}" />
                </StackPanel>
            </ui:Button>
            <ui:Button Click="ShowExamples_Click"
                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="QuestionCircle24" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding [TestData_Examples_Button], Source={x:Static res:Translations.Current}}" />
                </StackPanel>
            </ui:Button>
        </StackPanel>
        <ui:TextBlock
            Grid.Row="1"
            Text="{Binding [TestData_ArgumentsHint], Source={x:Static res:Translations.Current}}"
            Appearance="Secondary"
            TextWrapping="Wrap"
            Margin="0,0,0,8" />
        <TextBox
            Grid.Row="2"
            Text="{Binding ViewModel.TestDataText, Mode=TwoWay}"
            AcceptsReturn="True"
            AcceptsTab="True"
            TextWrapping="NoWrap"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            MinHeight="200" />
    </Grid>
</Page>
