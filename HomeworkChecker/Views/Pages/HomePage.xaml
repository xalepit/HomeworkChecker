<Page
  x:Class="HomeworkChecker.UI.Views.Pages.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="clr-namespace:HomeworkChecker.Core.Models;assembly=HomeworkChecker.Core"
  xmlns:controls="clr-namespace:HomeworkChecker.UI.Views.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:HomeworkChecker.UI.Views.Pages"
  xmlns:res="clr-namespace:HomeworkChecker.UI.Resources"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  d:DataContext="{d:DesignInstance local:HomePage, IsDesignTimeCreatable=False}"
  d:DesignHeight="700"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RunOutputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#20000000" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="0,0,12,24">
            <ui:TextBlock Text="{Binding [Home_ExecutableSection], Source={x:Static res:Translations.Current}}"
                          FontTypography="Subtitle"
                          Margin="0,10,0,10" />

            <ui:Card Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="WindowConsole20" Margin="0,0,15,0" />
                    <StackPanel Grid.Column="1">
                        <ui:TextBlock Text="{Binding [Home_Demo_Title], Source={x:Static res:Translations.Current}}" FontTypography="Body" />
                        <ui:TextBlock Text="{Binding [Home_Demo_Description], Source={x:Static res:Translations.Current}}" FontTypography="Caption" Appearance="Secondary" />
                    </StackPanel>
                    <ui:TextBlock Grid.Column="2"
                                  Margin="16,0"
                                  MaxWidth="640"
                                  Text="{Binding ViewModel.DemoExePath}"
                                  TextWrapping="Wrap"
                                  ToolTip="{Binding ViewModel.DemoExePath}"
                                  FontSize="{Binding ViewModel.DemoExePathFontSize}"
                                  LineHeight="13"
                                  LineStackingStrategy="BlockLineHeight"
                                  Appearance="Secondary"
                                  HorizontalAlignment="Right"
                                  TextAlignment="Right"
                                  VerticalAlignment="Center" />
                    <ui:Button Grid.Column="3"
                               Margin="15,0,0,0"
                               Content="{Binding [Common_SelectFile], Source={x:Static res:Translations.Current}}"
                               IsEnabled="{Binding ViewModel.CanConfigure}"
                               Command="{Binding ViewModel.SelectDemoExeCommand}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Code20" Margin="0,0,15,0" />
                    <StackPanel Grid.Column="1">
                        <ui:TextBlock Text="{Binding [Home_Student_Title], Source={x:Static res:Translations.Current}}" FontTypography="Body" />
                        <ui:TextBlock Text="{Binding [Home_Student_Description], Source={x:Static res:Translations.Current}}" FontTypography="Caption" Appearance="Secondary" />
                    </StackPanel>
                    <ui:TextBlock Grid.Column="2"
                                  Margin="16,0"
                                  MaxWidth="640"
                                  Text="{Binding ViewModel.StudentExePath}"
                                  TextWrapping="Wrap"
                                  ToolTip="{Binding ViewModel.StudentExePath}"
                                  FontSize="{Binding ViewModel.StudentExePathFontSize}"
                                  LineHeight="13"
                                  LineStackingStrategy="BlockLineHeight"
                                  Appearance="Secondary"
                                  HorizontalAlignment="Right"
                                  TextAlignment="Right"
                                  VerticalAlignment="Center" />
                    <ui:Button Grid.Column="3"
                               Margin="15,0,0,0"
                               Content="{Binding [Common_SelectFile], Source={x:Static res:Translations.Current}}"
                               IsEnabled="{Binding ViewModel.CanConfigure}"
                               Command="{Binding ViewModel.SelectStudentExeCommand}" />
                </Grid>
            </ui:Card>

            <ui:TextBlock Text="{Binding ViewModel.PathValidationMessage}"
                          Foreground="#D13438"
                          TextWrapping="Wrap"
                          Margin="4,4,4,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <ui:Button Content="{Binding [Common_StartCheck], Source={x:Static res:Translations.Current}}"
                           Appearance="Primary"
                           MinWidth="150"
                           Height="42"
                           IsEnabled="{Binding ViewModel.CanStartCompare}"
                           Command="{Binding ViewModel.StartCompareCommand}" />
                <ui:Button Content="{Binding [Home_CancelCheck], Source={x:Static res:Translations.Current}}"
                           Margin="10,0,0,0"
                           MinWidth="100"
                           Height="42"
                           IsEnabled="{Binding ViewModel.IsRunning}"
                           Command="{Binding ViewModel.CancelCompareCommand}" />
            </StackPanel>

            <StackPanel Margin="0,18,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsRunning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding ViewModel.ProgressText}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <ProgressBar Minimum="0" Maximum="{Binding ViewModel.TotalCount}" Value="{Binding ViewModel.CompletedCount}" Height="8" />
            </StackPanel>

            <StackPanel Margin="0,28,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.Results.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ui:TextBlock Text="{Binding [Home_ResultSection], Source={x:Static res:Translations.Current}}" FontTypography="Subtitle" />

                <WrapPanel Margin="0,6,0,20" TextElement.FontSize="17">
                    <TextBlock Text="{Binding [Home_TotalCases], Source={x:Static res:Translations.Current}}" />
                    <TextBlock Text="{Binding ViewModel.ResultTotalCount}" FontWeight="SemiBold" Margin="5,0,18,0" />
                    <TextBlock Text="{Binding [Home_CompletionRate], Source={x:Static res:Translations.Current}}" />
                    <TextBlock Text="{Binding ViewModel.CompletionRateText}" Foreground="{Binding ViewModel.CompletionRateColor}" FontWeight="SemiBold" Margin="5,0,18,0" />
                    <TextBlock Text="{Binding [Home_PassRate], Source={x:Static res:Translations.Current}}" />
                    <TextBlock Text="{Binding ViewModel.PassRateText}" Foreground="{Binding ViewModel.PassRateColor}" FontWeight="SemiBold" Margin="5,0,0,0" />
                </WrapPanel>

                <Grid Margin="0,0,0,10" TextElement.FontSize="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" TextElement.Foreground="#73BF7A" TextElement.FontWeight="SemiBold"><TextBlock Text="{Binding [Result_Passed], Source={x:Static res:Translations.Current}}" FontSize="13" /><TextBlock Text="{Binding ViewModel.PassedCount}" FontSize="13" Margin="4,0,0,0" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" TextElement.Foreground="#DE7770" TextElement.FontWeight="SemiBold"><TextBlock Text="{Binding [Result_Failed], Source={x:Static res:Translations.Current}}" FontSize="13" /><TextBlock Text="{Binding ViewModel.FailedCount}" FontSize="13" Margin="4,0,0,0" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" TextElement.Foreground="#D99A61" TextElement.FontWeight="SemiBold"><TextBlock Text="{Binding [Result_TimedOut], Source={x:Static res:Translations.Current}}" FontSize="13" /><TextBlock Text="{Binding ViewModel.TimedOutCount}" FontSize="13" Margin="4,0,0,0" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" TextElement.Foreground="#C9AA55" TextElement.FontWeight="SemiBold"><TextBlock Text="{Binding [Result_InvalidTestData], Source={x:Static res:Translations.Current}}" FontSize="13" /><TextBlock Text="{Binding ViewModel.InvalidTestDataCount}" FontSize="13" Margin="4,0,0,0" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" TextElement.Foreground="#B88A8A" TextElement.FontWeight="SemiBold"><TextBlock Text="{Binding [Result_ExecutionFailed], Source={x:Static res:Translations.Current}}" FontSize="13" /><TextBlock Text="{Binding ViewModel.ExecutionFailedCount}" FontSize="13" Margin="4,0,0,0" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" TextElement.Foreground="#9E9E9E" TextElement.FontWeight="SemiBold"><TextBlock Text="{Binding [Result_Cancelled], Source={x:Static res:Translations.Current}}" FontSize="13" /><TextBlock Text="{Binding ViewModel.CancelledCount}" FontSize="13" Margin="4,0,0,0" /></StackPanel>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
                        <ui:TextBlock Text="{Binding [Home_TotalElapsed], Source={x:Static res:Translations.Current}}" Appearance="Secondary" />
                        <ui:TextBlock Text="{Binding ViewModel.TotalElapsedSeconds, StringFormat={}{0:F2}}" Appearance="Secondary" Margin="4,0" />
                        <ui:TextBlock Text="{Binding [Settings_Timeout_Unit], Source={x:Static res:Translations.Current}}" Appearance="Secondary" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="ResultsList"
                         ItemsSource="{Binding ViewModel.PagedResults}"
                         SelectedItem="{Binding ViewModel.SelectedResult, Mode=TwoWay}"
                         SelectionChanged="ResultsList_SelectionChanged"
                         Margin= "0,0,0,10"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8" Margin="0,0,0,8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ResultTile"
                                    Height="108"
                                    Margin="4"
                                    CornerRadius="7"
                                    BorderThickness="2"
                                    BorderBrush="#4D4D4D"
                                    Background="#6B6B6B"
                                    TextElement.Foreground="White">
                                <Grid ClipToBounds="True">
                                    <Path x:Name="TileFoldBack" Data="M 0,26 L 26,0 L 26,26 Z" Width="26" Height="26" Stretch="Fill" Fill="#BDBDBD" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    <Path x:Name="TileFoldFront" Data="M 0,18 L 18,0 L 18,18 Z" Width="18" Height="18" Stretch="Fill" Fill="#DDDDDD" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    <Grid Margin="12,8,12,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="4*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Viewbox Grid.Column="0" Width="50" Height="48" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TestCase.Index, StringFormat={}{0}}" FontSize="38" FontWeight="SemiBold" />
                                        </Viewbox>
                                        <Viewbox Grid.Row="1" Grid.Column="0" Width="62" Height="24" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                            <TextBlock x:Name="StatusText" FontSize="19" FontWeight="SemiBold" />
                                        </Viewbox>
                                        <ui:SymbolIcon x:Name="StatusIcon" Grid.Column="1" Grid.RowSpan="2" Symbol="Stop24" FontSize="52" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-6,0,6,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.Passed}">
                                    <Setter TargetName="StatusText" Property="Text" Value="{Binding [Result_Passed], Source={x:Static res:Translations.Current}}" />
                                    <Setter TargetName="StatusText" Property="FontSize" Value="21" />
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="CheckmarkCircle48" />
                                    <Setter TargetName="ResultTile" Property="Background" Value="#388E4C" />
                                    <Setter TargetName="ResultTile" Property="BorderBrush" Value="#2C703B" />
                                    <Setter TargetName="TileFoldBack" Property="Fill" Value="#78C488" />
                                    <Setter TargetName="TileFoldFront" Property="Fill" Value="#A7DBB1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.Failed}">
                                    <Setter TargetName="StatusText" Property="Text" Value="{Binding [Result_Failed], Source={x:Static res:Translations.Current}}" />
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="DismissCircle48" />
                                    <Setter TargetName="ResultTile" Property="Background" Value="#AA3F36" />
                                    <Setter TargetName="ResultTile" Property="BorderBrush" Value="#823028" />
                                    <Setter TargetName="TileFoldBack" Property="Fill" Value="#D07770" />
                                    <Setter TargetName="TileFoldFront" Property="Fill" Value="#E5ADA8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.TimedOut}">
                                    <Setter TargetName="StatusText" Property="Text" Value="{Binding [Result_TimedOut], Source={x:Static res:Translations.Current}}" />
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="Clock48" />
                                    <Setter TargetName="ResultTile" Property="Background" Value="#D56A16" />
                                    <Setter TargetName="ResultTile" Property="BorderBrush" Value="#A44F0D" />
                                    <Setter TargetName="TileFoldBack" Property="Fill" Value="#E99B5D" />
                                    <Setter TargetName="TileFoldFront" Property="Fill" Value="#F4C197" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.InvalidTestData}">
                                    <Setter TargetName="StatusText" Property="Text" Value="{Binding [Result_InvalidTestData], Source={x:Static res:Translations.Current}}" />
                                    <Setter TargetName="StatusText" Property="FontSize" Value="17" />
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="QuestionCircle48" />
                                    <Setter TargetName="ResultTile" Property="Background" Value="#B48608" />
                                    <Setter TargetName="ResultTile" Property="BorderBrush" Value="#866304" />
                                    <Setter TargetName="TileFoldBack" Property="Fill" Value="#DEC35F" />
                                    <Setter TargetName="TileFoldFront" Property="Fill" Value="#F2DE9B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.ExecutionFailed}">
                                    <Setter TargetName="StatusText" Property="Text" Value="{Binding [Result_ExecutionFailed], Source={x:Static res:Translations.Current}}" />
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="ErrorCircle48" />
                                    <Setter TargetName="ResultTile" Property="Background" Value="#8A5555" />
                                    <Setter TargetName="ResultTile" Property="BorderBrush" Value="#653C3C" />
                                    <Setter TargetName="TileFoldBack" Property="Fill" Value="#BA8585" />
                                    <Setter TargetName="TileFoldFront" Property="Fill" Value="#D9BABA" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.Cancelled}">
                                    <Setter TargetName="StatusText" Property="Text" Value="{Binding [Result_Cancelled], Source={x:Static res:Translations.Current}}" />
                                    <Setter TargetName="StatusIcon" Property="Symbol" Value="Stop24" />
                                    <Setter TargetName="ResultTile" Property="Background" Value="#6C6C6C" />
                                    <Setter TargetName="ResultTile" Property="BorderBrush" Value="#4D4D4D" />
                                    <Setter TargetName="TileFoldBack" Property="Fill" Value="#999999" />
                                    <Setter TargetName="TileFoldFront" Property="Fill" Value="#C9C9C9" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ResultTile" Property="BorderThickness" Value="3" />
                                    <Setter TargetName="ResultTile" Property="BorderBrush" Value="White" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding ViewModel.HasMultiplePages}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:Button Content="◀" Width="42" Height="36" IsEnabled="{Binding ViewModel.CanGoToPreviousPage}" Command="{Binding ViewModel.GoToPreviousPageCommand}" />
                    <ui:NumberBox Width="64" Height="36" Margin="10,0" FontSize="18" FontWeight="SemiBold" Minimum="1" Maximum="{Binding ViewModel.PageCount}" MaxDecimalPlaces="0" SmallChange="1" SpinButtonPlacementMode="Hidden" Value="{Binding ViewModel.CurrentPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="/" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ViewModel.PageCount}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,10,0" />
                    <ui:Button Content="▶" Width="42" Height="36" IsEnabled="{Binding ViewModel.CanGoToNextPage}" Command="{Binding ViewModel.GoToNextPageCommand}" />
                </StackPanel>
            </StackPanel>

            <ContentControl x:Name="DetailSection" Content="{Binding ViewModel.SelectedResult}" Margin="0,18,0,0">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{Binding [Home_DetailSection], Source={x:Static res:Translations.Current}}" FontTypography="Subtitle" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Content="{Binding [Home_PreviousCase], Source={x:Static res:Translations.Current}}"
                                                   IsEnabled="{Binding DataContext.ViewModel.CanSelectPrevious, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   Command="{Binding DataContext.ViewModel.SelectPreviousCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                                        <ui:Button Content="{Binding [Home_NextCase], Source={x:Static res:Translations.Current}}"
                                                   Margin="6,0,0,0"
                                                   IsEnabled="{Binding DataContext.ViewModel.CanSelectNext, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   Command="{Binding DataContext.ViewModel.SelectNextCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                                        <ui:Button Content="{Binding [Home_CollapseDetails], Source={x:Static res:Translations.Current}}"
                                                   Margin="6,0,0,0"
                                                   Command="{Binding DataContext.ViewModel.CollapseDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,8,0,12">
                                    <TextBlock Text="{Binding [Home_CaseLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TestCase.Index, StringFormat={}{0}}" Margin="4,0,18,0" />
                                    <TextBlock Text="{Binding [Home_GroupLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TestCase.GroupName}" Margin="4,0,18,0" />
                                    <TextBlock Text="{Binding [Home_StatusLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DataContext.ViewModel.SelectedStatusText, RelativeSource={RelativeSource AncestorType=Page}}" Margin="4,0,18,0" />
                                    <TextBlock Text="{Binding [Home_DiffCountLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Comparison.DiffLineCount}" Margin="4,0,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ViewModel.SelectedTargetText, RelativeSource={RelativeSource AncestorType=Page}}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding [Home_TargetLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DataContext.ViewModel.SelectedTargetText, RelativeSource={RelativeSource AncestorType=Page}}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding [Home_ArgumentsLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DataContext.ViewModel.SelectedArgumentText, RelativeSource={RelativeSource AncestorType=Page}}" Margin="4,0,0,0" TextWrapping="Wrap" />
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,10">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Comparison}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <TextBlock Text="{Binding [Home_DemoEncodingLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Comparison.EncodingName1}" Margin="4,0,18,0" />
                                    <TextBlock Text="{Binding [Home_StudentEncodingLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Comparison.EncodingName2}" Margin="4,0,0,0" />
                                </WrapPanel>

                                <Border Padding="10" Margin="0,0,0,10" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#186C6C6C" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.Passed}"><Setter Property="Background" Value="#18388E4C" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.Failed}"><Setter Property="Background" Value="#18AA3F36" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.TimedOut}"><Setter Property="Background" Value="#18D56A16" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.InvalidTestData}"><Setter Property="Background" Value="#18B48608" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:TestCaseRunStatus.ExecutionFailed}"><Setter Property="Background" Value="#188A5555" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DataContext.ViewModel.SelectedDiagnosticText, RelativeSource={RelativeSource AncestorType=Page}}" TextWrapping="Wrap" />
                                </Border>

                                <Expander Header="{Binding [Home_InputSection], Source={x:Static res:Translations.Current}}" Margin="0,0,0,10">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel">
                                        <Grid Margin="8">
                                            <TextBlock Text="{Binding TestCase.InputData}" FontFamily="Cascadia Mono, Consolas">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestCase.InputData}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding [Home_NoInputData], Source={x:Static res:Translations.Current}}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontStyle="Italic"
                                                       Visibility="Collapsed">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TestCase.InputData}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ScrollViewer>
                                </Expander>

                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ViewModel.HasSelectedDifferences, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:TextBlock Text="{Binding [Home_LineDifferences], Source={x:Static res:Translations.Current}}" FontTypography="BodyStrong" Margin="0,4,0,4" />
                                    <TextBlock Text="{Binding [Home_InvisibleCharactersNote], Source={x:Static res:Translations.Current}}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Comparison.DiffDetails}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" Margin="0,0,0,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                    <StackPanel>
                                                        <WrapPanel Margin="0,0,0,8" TextElement.FontWeight="SemiBold">
                                                            <TextBlock Text="{Binding [Home_DifferenceLinePrefix], Source={x:Static res:Translations.Current}}" />
                                                            <TextBlock Text="{Binding LineNumber1}" />
                                                            <TextBlock Text="{Binding [Home_DifferenceLineSuffix], Source={x:Static res:Translations.Current}}" Margin="0,0,6,0" />
                                                            <TextBlock x:Name="DifferenceTypeText" />
                                                            <StackPanel x:Name="FirstDifferenceMessage" Orientation="Horizontal" Visibility="Collapsed">
                                                                <TextBlock Text="{Binding [Home_FirstDifferencePrefix], Source={x:Static res:Translations.Current}}" />
                                                                <TextBlock Text="{Binding FirstDifferenceIndex}" />
                                                                <TextBlock Text="{Binding [Home_FirstDifferenceSuffix], Source={x:Static res:Translations.Current}}" />
                                                            </StackPanel>
                                                        </WrapPanel>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <WrapPanel Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding [Home_DemoLine], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                                                    <TextBlock x:Name="DemoLineNumber" Text="{Binding LineNumber1}" Margin="4,0,0,0" />
                                                                </WrapPanel>
                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel">
                                                                    <StackPanel TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="14">
                                                                        <ui:TextBlock Text="{Binding Ruler1}" Appearance="Secondary" FontFamily="Cascadia Mono, Consolas" FontSize="14" Margin="0,0,0,6" />
                                                                        <Grid>
                                                                            <controls:DiffLineTextBlock x:Name="DemoLineText" LineText="{Binding File1Content}" DifferentPositions="{Binding DifferentPositions1}" FontFamily="Cascadia Mono, Consolas" FontSize="14" />
                                                                            <ui:TextBlock x:Name="DemoLinePlaceholder" FontStyle="Italic" Appearance="Secondary" Visibility="Collapsed" />
                                                                        </Grid>
                                                                        <Border HorizontalAlignment="Left" Padding="5,1" Margin="0,4,0,10" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                                            <TextBlock x:Name="DemoEnding" Tag="{Binding File1LineEnding}" FontWeight="SemiBold">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="&lt;EOF&gt;" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding File1LineEnding}" Value="{x:Static core:LineEndingType.Cr}"><Setter Property="Text" Value="&lt;CR&gt;" /></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding File1LineEnding}" Value="{x:Static core:LineEndingType.Lf}"><Setter Property="Text" Value="&lt;LF&gt;" /></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding File1LineEnding}" Value="{x:Static core:LineEndingType.CrLf}"><Setter Property="Text" Value="&lt;CR&gt;&lt;LF&gt;" /></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </ScrollViewer>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2">
                                                                <WrapPanel Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding [Home_StudentLine], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                                                    <TextBlock x:Name="StudentLineNumber" Text="{Binding LineNumber2}" Margin="4,0,0,0" />
                                                                </WrapPanel>
                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel">
                                                                    <StackPanel TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="14">
                                                                        <ui:TextBlock Text="{Binding Ruler2}" Appearance="Secondary" FontFamily="Cascadia Mono, Consolas" FontSize="14" Margin="0,0,0,6" />
                                                                        <Grid>
                                                                            <controls:DiffLineTextBlock x:Name="StudentLineText" LineText="{Binding File2Content}" DifferentPositions="{Binding DifferentPositions2}" FontFamily="Cascadia Mono, Consolas" FontSize="14" />
                                                                            <ui:TextBlock x:Name="StudentLinePlaceholder" FontStyle="Italic" Appearance="Secondary" Visibility="Collapsed" />
                                                                        </Grid>
                                                                        <Border HorizontalAlignment="Left" Padding="5,1" Margin="0,4,0,10" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                                            <TextBlock FontWeight="SemiBold">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="&lt;EOF&gt;" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding File2LineEnding}" Value="{x:Static core:LineEndingType.Cr}"><Setter Property="Text" Value="&lt;CR&gt;" /></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding File2LineEnding}" Value="{x:Static core:LineEndingType.Lf}"><Setter Property="Text" Value="&lt;LF&gt;" /></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding File2LineEnding}" Value="{x:Static core:LineEndingType.CrLf}"><Setter Property="Text" Value="&lt;CR&gt;&lt;LF&gt;" /></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Expander Header="{Binding [Home_HexSection], Source={x:Static res:Translations.Current}}" Margin="0,10,0,0">
                                                            <StackPanel>
                                                                <ui:TextBlock Text="{Binding [Home_RawBytesNote], Source={x:Static res:Translations.Current}}" Appearance="Secondary" Margin="0,0,0,6" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                                        <TextBlock Text="{Binding HexDump1}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" />
                                                                    </ScrollViewer>
                                                                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                                        <TextBlock Text="{Binding HexDump2}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" />
                                                                    </ScrollViewer>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static core:DifferenceType.ContentMismatch}"><Setter TargetName="FirstDifferenceMessage" Property="Visibility" Value="Visible" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static core:DifferenceType.LineEndingMismatch}"><Setter TargetName="DifferenceTypeText" Property="Text" Value="{Binding [Difference_LineEndingMismatch], Source={x:Static res:Translations.Current}}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static core:DifferenceType.File1HasExtraCharacters}"><Setter TargetName="DifferenceTypeText" Property="Text" Value="{Binding [Difference_File1HasExtraCharacters], Source={x:Static res:Translations.Current}}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static core:DifferenceType.File2HasExtraCharacters}"><Setter TargetName="DifferenceTypeText" Property="Text" Value="{Binding [Difference_File2HasExtraCharacters], Source={x:Static res:Translations.Current}}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static core:DifferenceType.File1Ended}"><Setter TargetName="DifferenceTypeText" Property="Text" Value="{Binding [Difference_File1Ended], Source={x:Static res:Translations.Current}}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static core:DifferenceType.File2Ended}"><Setter TargetName="DifferenceTypeText" Property="Text" Value="{Binding [Difference_File2Ended], Source={x:Static res:Translations.Current}}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding File1HasLine}" Value="False"><Setter TargetName="DemoLineNumber" Property="Text" Value="—" /><Setter TargetName="DemoLineText" Property="Visibility" Value="Collapsed" /><Setter TargetName="DemoLinePlaceholder" Property="Text" Value="{Binding [Home_FileEnded], Source={x:Static res:Translations.Current}}" /><Setter TargetName="DemoLinePlaceholder" Property="Visibility" Value="Visible" /></DataTrigger>
                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding File1HasLine}" Value="True" /><Condition Binding="{Binding File1Content}" Value="" /></MultiDataTrigger.Conditions><Setter TargetName="DemoLinePlaceholder" Property="Text" Value="{Binding [Home_EmptyLine], Source={x:Static res:Translations.Current}}" /><Setter TargetName="DemoLinePlaceholder" Property="Visibility" Value="Visible" /></MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding File2HasLine}" Value="False"><Setter TargetName="StudentLineNumber" Property="Text" Value="—" /><Setter TargetName="StudentLineText" Property="Visibility" Value="Collapsed" /><Setter TargetName="StudentLinePlaceholder" Property="Text" Value="{Binding [Home_FileEnded], Source={x:Static res:Translations.Current}}" /><Setter TargetName="StudentLinePlaceholder" Property="Visibility" Value="Visible" /></DataTrigger>
                                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding File2HasLine}" Value="True" /><Condition Binding="{Binding File2Content}" Value="" /></MultiDataTrigger.Conditions><Setter TargetName="StudentLinePlaceholder" Property="Text" Value="{Binding [Home_EmptyLine], Source={x:Static res:Translations.Current}}" /><Setter TargetName="StudentLinePlaceholder" Property="Visibility" Value="Visible" /></MultiDataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Expander Header="{Binding [Home_RunInformation], Source={x:Static res:Translations.Current}}">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding [Home_DemoOutputLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                        <Border Grid.Row="1" Style="{StaticResource RunOutputBorderStyle}"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel"><TextBlock Text="{Binding DemoExecution.StandardOutput}" FontFamily="Cascadia Mono, Consolas" /></ScrollViewer></Border>
                                        <TextBlock Grid.Row="2" Text="{Binding [Home_DemoErrorLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                        <Border Grid.Row="3" Style="{StaticResource RunOutputBorderStyle}"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel"><TextBlock Text="{Binding DemoExecution.StandardError}" FontFamily="Cascadia Mono, Consolas" /></ScrollViewer></Border>
                                        <WrapPanel Grid.Row="4"><TextBlock Text="{Binding [Home_ExitCodeLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" /><TextBlock Text="{Binding DemoExecution.ExitCode}" Margin="4,0,14,0" /><TextBlock Text="{Binding [Home_ElapsedLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" /><TextBlock Text="{Binding DemoExecution.Elapsed.TotalSeconds, StringFormat={}{0:F3}}" Margin="4,0" /><TextBlock Text="{Binding [Settings_Timeout_Unit], Source={x:Static res:Translations.Current}}" /></WrapPanel>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [Home_StudentOutputLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource RunOutputBorderStyle}"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel"><TextBlock Text="{Binding StudentExecution.StandardOutput}" FontFamily="Cascadia Mono, Consolas" /></ScrollViewer></Border>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding [Home_StudentErrorLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" />
                                        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource RunOutputBorderStyle}"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel"><TextBlock Text="{Binding StudentExecution.StandardError}" FontFamily="Cascadia Mono, Consolas" /></ScrollViewer></Border>
                                        <WrapPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="{Binding [Home_ExitCodeLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" /><TextBlock Text="{Binding StudentExecution.ExitCode}" Margin="4,0,14,0" /><TextBlock Text="{Binding [Home_ElapsedLabel], Source={x:Static res:Translations.Current}}" FontWeight="SemiBold" /><TextBlock Text="{Binding StudentExecution.Elapsed.TotalSeconds, StringFormat={}{0:F3}}" Margin="4,0" /><TextBlock Text="{Binding [Settings_Timeout_Unit], Source={x:Static res:Translations.Current}}" /></WrapPanel>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
    </StackPanel>
</Page>
