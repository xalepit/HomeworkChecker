<Page
  x:Class="HomeworkChecker.UI.Views.Pages.TcSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:HomeworkChecker.UI.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="文本比较配置（txt_compare）"
  d:DataContext="{d:DesignInstance local:TcSettingsPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
    <StackPanel>

        <ui:TextBlock Text="文本比较参数" FontTypography="Subtitle" Margin="0,10,0,10" />

        <!-- trim -->
        <ui:Card Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="185" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="TextGrammarWand24" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1">
                    <ui:TextBlock Text="空白处理方式（trim）" FontTypography="Body" Appearance="Primary" />
                    <ui:TextBlock Text="指定每行对空格/Tab的忽略规则：none / left / right / all。" FontTypography="Caption" Appearance="Secondary" />
                </StackPanel>
                <ComboBox Grid.Column="2"
                      SelectedValue="{Binding ViewModel.TrimMode, Mode=TwoWay}"
                      SelectedValuePath="Tag">
                    <ComboBoxItem Content="none（严格匹配）" Tag="none" />
                    <ComboBoxItem Content="left（忽略行首空白）" Tag="left" />
                    <ComboBoxItem Content="right（忽略行尾空白）" Tag="right" />
                    <ComboBoxItem Content="all（忽略首尾空白）" Tag="all" />
                </ComboBox>
            </Grid>
        </ui:Card>

        <!-- lineskip -->
        <ui:Card Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="SkipForwardTab24" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1">
                    <ui:TextBlock Text="跳过前置行数（--lineskip）" FontTypography="Body" Appearance="Primary" />
                    <ui:TextBlock Text="范围 [0..100]。两个文件同时跳过前 s 行再开始比较。" FontTypography="Caption" Appearance="Secondary" />
                </StackPanel>
                <ui:TextBox Grid.Column="2"
                        PlaceholderText="默认 0（例如：5）"
                        Text="{Binding ViewModel.LineSkipText, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

        <!-- lineoffset -->
        <ui:Card Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSwap24" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1">
                    <ui:TextBlock Text="错位行偏移（--lineoffset）" FontTypography="Body" Appearance="Primary" />
                    <ui:TextBlock Text="范围 [-100..100]。负数忽略 file1 前 n 行，正数忽略 file2 前 n 行。" FontTypography="Caption" Appearance="Secondary" />
                </StackPanel>
                <ui:TextBox Grid.Column="2"
                        PlaceholderText="默认 0（例如：-2 或 3）"
                        Text="{Binding ViewModel.LineOffsetText, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

        <!-- ignore blank -->
        <ui:Card Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Eraser24" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1">
                    <ui:TextBlock Text="忽略空行（--ignore_blank）" FontTypography="Body" Appearance="Primary" />
                    <ui:TextBlock Text="开启后，忽略 trim 处理后的所有空行。" FontTypography="Caption" Appearance="Secondary" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2"
                             OnContent="开启"
                             OffContent="关闭"
                             IsChecked="{Binding ViewModel.IgnoreBlank, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

        <!-- CR/CRLF -->
        <ui:Card Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="TextWrap24" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1">
                    <ui:TextBlock Text="严格区分换行符（--CR_CRLF_not_equal）" FontTypography="Body" Appearance="Primary" />
                    <ui:TextBlock Text="开启后，Windows（CRLF）与 Linux（LF）换行差异会判定为不相等。" FontTypography="Caption" Appearance="Secondary" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2"
                             OnContent="严格区分"
                             OffContent="忽略差异"
                             IsChecked="{Binding ViewModel.CrCrLfNotEqual, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

        <!-- max diff -->
        <ui:Card Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="TextGrammarDismiss24" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1">
                    <ui:TextBlock Text="最大差异行数（--max_diff）" FontTypography="Body" Appearance="Primary" />
                    <ui:TextBlock Text="范围 [0..100]。达到 m 行差异后提前停止比较。" FontTypography="Caption" Appearance="Secondary" />
                </StackPanel>
                <ui:TextBox Grid.Column="2"
                        PlaceholderText="默认 0（例如：10）"
                        Text="{Binding ViewModel.MaxDiffText, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

        <!-- max line -->
        <ui:Card Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Line24" Margin="0,0,15,0" />
                <StackPanel Grid.Column="1">
                    <ui:TextBlock Text="最大比较行数（--max_line）" FontTypography="Body" Appearance="Primary" />
                    <ui:TextBlock Text="范围 [0..10000]。比较到 x 行后停止，不再继续。" FontTypography="Caption" Appearance="Secondary" />
                </StackPanel>
                <ui:TextBox Grid.Column="2"
                        PlaceholderText="默认 0（例如：200）"
                        Text="{Binding ViewModel.MaxLineText, Mode=TwoWay}" />
            </Grid>
        </ui:Card>

    </StackPanel>
</Page>
